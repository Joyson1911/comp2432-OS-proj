int count_messages(const char *buffer) {
    int count = 0;
    const char *ptr = buffer;

    // Iterate through the buffer and count the number of ';' characters
    while (*ptr != '\0') {
        if (*ptr == ';') {
            count++;
        }
        ptr++;
    }

    return count;
}
void separate_messages(const char *buffer, char **messages, int num_messages) {
    char *token;
    char temp_buffer[strlen(buffer) + 1]; // Temporary buffer for strtok

    // Copy the original buffer to a temporary buffer (strtok modifies the input string)
    strcpy(temp_buffer, buffer);

    // Tokenize the string based on ';'
    token = strtok(temp_buffer, ";");
    int index = 0;

    while (token != NULL && index < num_messages) {
        // Remove leading/trailing whitespace (optional)
        while (*token == ' ' || *token == '\t' || *token == '\n') {
            token++;
        }

        // Allocate memory for the current message and copy it
        messages[index] = (char *)malloc((strlen(token) + 1) * sizeof(char)); //Allocates the size of meassage Memory 
        strcpy(messages[index], token); //copy token to message

        index++;
        token = strtok(NULL, ";");
    }
}
