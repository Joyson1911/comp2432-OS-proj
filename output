    returnpid = fork();

    int child_to_parent[2];
    pipe(child_to_parent);
        if (returnpid == -1)
        {
            printf("fork error\n");
            exit(1);
        }
        else if (returnpid == 0)
        {
            // Child process
            record array[2][10]={
                                    {"Park",'A',20250510,1000,3,1300,'1',"Battery","Cable"},
                                    {"Park",'B',20250510,1000,3,1300,'1',"Battery","Cable"}
                                    };
            close(child_to_parent[0]); // Close unused read end
            write(child_to_parent[1], array , sizeof(array));
            close(child_to_parent[1]); // Close write end after writing
            exit(0);
        }
        else
        {
            // Parent process
          
        }
    record buffer[2][10];
