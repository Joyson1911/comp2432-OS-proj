typedef struct
{
    char name[20];
    char member;
    int date;
    int startTime;
    int timeDuration;
    int endTime;
    char priority;
    char essential1[30];
    char essential2[30];
    char essential3[30];
    char essential4[30];
    char essential5[30];
    char essential6[30];
} record;
typedef struct {
    record result[2][2000]; //0 is reject, 1 is accept
    int rejectCounter;
    int acceptCounter;
    char method[100];
}outputBlock;

int compare_records(const void *a, const void *b)
{
    record *recordA = (record *)a;
    record *recordB = (record *)b;

    // First sort by member
    if (recordA->member != recordB->member)
    {
        return recordA->member - recordB->member;
    }
    // Then by date
    if (recordA->date != recordB->date)
    {
        return recordA->date - recordB->date;
    }
    // Then by start time
    return recordA->startTime - recordB->startTime;
}
int compare_records_prio(const void *a, const void *b){
    record *recordA = (record *)a;
    record *recordB = (record *)b;
    // First sort by member (to keep grouping)
    if (recordA->member != recordB->member) {
        return recordA->member - recordB->member;
    }
    // Then sort by priority
    if (recordA->priority != recordB->priority) {
        return recordA->priority - recordB->priority;
    }
    // Then by date (for records with same priority)
    if (recordA->date != recordB->date) {
        return recordA->date - recordB->date;
    }
    // Finally by start time (for records with same priority and date)
    return recordA->startTime - recordB->startTime;
}


void copy_record(record buffer[2][2000], outputBlock store_array, int size_0, int size_1)
{
    int i;
    int j;
    int loop=0;
    for (i = 0; i < 2; i++)
    {
        if (i==0){
            loop=size_0;
        }
        else if (i==1){
            loop=size_1;
        }
        else{
            perror("copy_record");
            exit(-1);
        }
        for (j = 0; j < loop; j++)
        {
            store_array.result[i][j] = buffer[i][j];
        }
    }

}
