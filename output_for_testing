int main()
{
    pid_t pid;
    int pipe_fd[2];
    
    if(pipe(pipe_fd) == -1 ){
        perror("pipe");
        exit(-1);
    }

    pid = fork();
    if (pid == -1)
    {
        perror("fork");
        exit(-1);
    }
    else if (pid == 0)
    {
        // Child process
        record array[2][10] = {
            // First dimension (store_array[0][0] to store_array[0][9])
            {
                {"Parking", 'A', 20250510, 1000, 3, 1300, '1', "Battery", "Cable"}, // [0][0]
                {"Essential", 'B', 20250511, 1100, 2, 1300, '2', "Lockers", "No"},  // [0][1]
                {"Event", 'A', 20250513, 1400, 5, 1900, '4', "Inflation", "Valet"}, // [0][2]
                {0}                                                                 // Mark end of records
            },
            // Second dimension (store_array[1][0] to store_array[1][9])
            {
                {"Reservation", 'C', 20250512, 930, 4, 1300, '3', "No", "Umbrella"}, // [1][0]
                {"Event", 'A', 20250513, 1400, 5, 1900, '4', "Inflation", "Valet"},  // [1][1]
                {"Essential", 'D', 20250511, 1100, 2, 1300, '2', "Lockers", "No"},
                {0}                                                                  // Mark end of records
            }
        };
        int size_0=3;
        int size_1=3;
        char method[100]="ACCEPTED / FCFS \0";
        close(pipe_fd[0]);
        write(pipe_fd[1], array, sizeof(array));
        write(pipe_fd[1], &size_0,sizeof(size_0));
        write(pipe_fd[1], &size_1,sizeof(size_1));
        write(pipe_fd[1], method, strlen(method)+1);// must add 1 for null termination 
        close(pipe_fd[1]);
        exit(0);
    }
    else
    {
        // Parent process
        record buffer[2][10] = {0};
        record store_array[2][10] = {0};
        int accept_counter = 0;
        int reject_counter = 0;
        char method[100];
        close(pipe_fd[1]);
        read(pipe_fd[0], buffer, sizeof(buffer));
        read(pipe_fd[0],&accept_counter,sizeof(accept_counter));
        read(pipe_fd[0],&reject_counter,sizeof(reject_counter));
        read(pipe_fd[0], method, sizeof(method));
        method[sizeof(method)-1] = '\0'; // Ensure null termination
        close(pipe_fd[0]);

        if(strstr(method,"ALL")!=0){
            print_report(store_array, accept_counter, reject_counter);
        }
        else{
        copy_record(buffer, store_array, accept_counter, reject_counter);
        print_records(store_array, accept_counter, reject_counter,method);
        }
    }

    return 0;
}
