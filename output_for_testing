#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>

typedef struct
{
    char name[20];
    char member;
    int date;
    int startTime;
    int timeDuration;
    int endTime;
    char priority;
    char essential1[30];
    char essential2[30];
} record;
int compare_records(const void *a, const void *b)
{
    record *recordA = (record *)a;
    record *recordB = (record *)b;

    // First sort by member
    if (recordA->member != recordB->member)
    {
        return recordA->member - recordB->member;
    }
    // Then by date
    if (recordA->date != recordB->date)
    {
        return recordA->date - recordB->date;
    }
    // Then by start time
    return recordA->startTime - recordB->startTime;
}

void copy_record(record buffer[2][10], record store_array[2][10], int size_0, int size_1)
{
    int i;
    int j;
    for (i = 0; i < 2; i++)
    {
        for (j = 0; j < size_1; j++)
        {
            store_array[i][j] = buffer[i][j];
        }
    }
}
void print_records(record records[2][10], int size_0, int size_1)
{
    int i;
    int j;
    char current_member = '\0';
    qsort(records[0], size_1, sizeof(record), compare_records);
    qsort(records[1], size_1, sizeof(record), compare_records);
    for (i = 0; i < 2; i++)
    {
        for (j = 0; j < size_1; j++)
        {
            // Skip empty records
            if (records[i][j].name[0] == '\0')
                continue;

            if (records[i][j].member != current_member)
            {
                current_member = records[i][j].member;
                printf("\n");
                printf("Member_%c has the following bookings:\n", current_member);
                printf("Date         Start    End       Type                 Device\n");
                printf("===========================================================================\n");
            }

            printf("%d-%02d-%02d   %02d:%02d   %02d:%02d      %-15s      ",
                   records[i][j].date / 10000,
                   (records[i][j].date % 10000) / 100,
                   records[i][j].date % 100,
                   records[i][j].startTime / 100,
                   records[i][j].startTime % 100,
                   records[i][j].endTime / 100,
                   records[i][j].endTime % 100,
                   records[i][j].name);

                if (strcmp(records[i][j].essential1, "NO") != 0) {
                printf("%s\n", records[i][j].essential1);
                printf("                                                     %s\n", records[i][j].essential2);
                } else {
                printf("*\n");
                }
            printf("\n");
        }
    }
}

int main()
{
    pid_t pid;
    int pipe_fd[2];
    
    if(pipe(pipe_fd) == -1 ){
        perror("pipe");
        exit(-1);
    }

    pid = fork();
    if (pid == -1)
    {
        perror("fork");
        exit(-1);
    }
    else if (pid == 0)
    {
        // Child process
        record array[2][10] = {
            // First dimension (store_array[0][0] to store_array[0][9])
            {
                {"Parking", 'A', 20250510, 1000, 3, 1300, '1', "Battery", "Cable"}, // [0][0]
                {"Essential", 'B', 20250511, 1100, 2, 1300, '2', "Lockers", "No"},  // [0][1]
                {"Event", 'A', 20250513, 1400, 5, 1900, '4', "Inflation", "Valet"}, // [0][2]
                {0}                                                                 // Mark end of records
            },
            // Second dimension (store_array[1][0] to store_array[1][9])
            {
                {"Reservation", 'C', 20250512, 930, 4, 1300, '3', "No", "Umbrella"}, // [1][0]
                {"Event", 'A', 20250513, 1400, 5, 1900, '4', "Inflation", "Valet"},  // [1][1]
                {"Essential", 'D', 20250511, 1100, 2, 1300, '2', "Lockers", "No"},
                {0}                                                                  // Mark end of records
            }
        };
        close(pipe_fd[0]);
        write(pipe_fd[1], array, sizeof(array));
        close(pipe_fd[1]);
        exit(0);
    }
    else
    {
        // Parent process
        record buffer[2][10] = {0};
        record store_array[2][10] = {0};
        int accept_counter = 0;
        int reject_counter = 0;
        close(pipe_fd[1]);
        read(pipe_fd[0], buffer, sizeof(buffer));
        close(pipe_fd[0]);

        int struct_size_0 = 3; // later read
        int struct_size_1 = 3; // later read
        copy_record(buffer, store_array, struct_size_0, struct_size_1);
        print_records(store_array, struct_size_0, struct_size_1);
    }

    return 0;
}




